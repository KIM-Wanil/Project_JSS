      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 1
      fingerAnimationAmount: 10
      completionCondition: "\uC81C\uC791\uBAA9\uB85D\uD074\uB9AD"
    - dialogue: "\uAC1D\uC2E4 \uC900\uBE44\uC5D0 \uD544\uC694\uD55C \uAC00\uAD6C\uB4E4\uC785\uB2C8\uB2E4."
