      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uC774\uCABD\uC73C\uB85C \uC548\uB0B4\uD574\uB4DC\uB9B4\uAC8C\uC694."
      characterPosition: {x: 290, y: 0}
