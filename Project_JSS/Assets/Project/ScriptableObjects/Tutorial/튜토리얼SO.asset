  tutorialEvents:
  - eventId: TUTORIAL1
    dialogues:
    - dialogue: "\uC624, \uBC14\uB85C \uCCAB \uC190\uB2D8\uC774 \uB3C4\uCC29\uD558\uC168\uAD70\uC694."
