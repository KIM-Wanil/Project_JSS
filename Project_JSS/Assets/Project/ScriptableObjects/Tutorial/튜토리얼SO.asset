      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uC790\uBB3C\uC1E0\uB85C \uC7A0\uACA8\uC788\uB294 \uBB3C\uAC74\uC740
        \uC774\uB3D9\uC740 \uB418\uC9C0 \uC54A\uC9C0\uB9CC, \uD569\uC131\uC740 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
