      highlightPosition: {x: 30, y: 320}
      highlightSize: {x: 660, y: 545}
      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uC6D0\uD558\uB294 \uACF3\uC744 \uCC3E\uC558\uC73C\uBA74 \uCCB4\uD06C
