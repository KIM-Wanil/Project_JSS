      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uAC1D\uC2E4\uC77C\uC218\uB85D,
