      characterPosition: {x: 290, y: 0}
      characterName: "\uBA54\uC774\uB4DC \uD3AD\uADC4"
      highlightPosition: {x: 0, y: 0}
      highlightSize: {x: 0, y: 0}
      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uAC00\uAD6C\uB294 \uB4DC\uB798\uADF8\uB97C \uD1B5\uD574 \uC774\uB3D9\uC2DC\uD0AC
        \uC218 \uC788\uACE0, \uBC29\uD5A5 \uC804\uD658\uC774 \uAC00\uB2A5\uD574\uC694."
