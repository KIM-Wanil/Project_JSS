      fingerRotation: 30
      fingerAnimType: 1
      fingerAnimationAmount: 0
      completionCondition: 1
    - dialogue: "\uC190\uB2D8\uAED8\uC11C \uC694\uCCAD\uD558\uC2E0 \uC758\uB8B0\uC11C\uB97C
        \uD568\uAED8 \uBCFC\uAE4C\uC694?"
      characterPosition: {x: 290, y: 0}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 15, y: 1045}
      highlightSize: {x: 150, y: 150}
      fingerPosition: {x: 227, y: 1090}
      fingerRotation: -150
      fingerAnimType: 1
      fingerAnimationAmount: 0
      completionCondition: 2
    - dialogue: "\uD544\uC694\uD55C \uBB3C\uAC74\uC744 \uB9CC\uB4E4\uC5B4 \uAC1D\uC2E4\uC744
        \uC900\uBE44\uD558\uB294 \uAC83\uC774 \uC800\uD76C\uC758 \uC77C\uC785\uB2C8\uB2E4."
      characterPosition: {x: 290, y: -370}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 85, y: 164}
      highlightSize: {x: 550, y: 900}
      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uBB3C\uAC74\uC744 \uB9CC\uB4DC\uB294 \uBC29\uBC95\uC744 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      characterPosition: {x: 290, y: -370}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 485, y: 845}
      highlightSize: {x: 120, y: 120}
      fingerPosition: {x: 547, y: 827}
      fingerRotation: 150
      fingerAnimType: 1
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uAC1D\uC2E4 \uC900\uBE44\uC758 \uAE30\uBCF8\uC740 \u2018\uD569\uC131\u2019\uC785\uB2C8\uB2E4."
      characterPosition: {x: 290, y: 330}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 20, y: 175}
      highlightSize: {x: 680, y: 865}
      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uAC19\uC740 \uBB3C\uAC74 \uB450 \uAC1C\uB97C \uB4DC\uB798\uADF8\uD558\uC5EC
        \uD569\uCE58\uBA74, \uB354 \uB192\uC740 \uB4F1\uAE09\uC758 \uC624\uBE0C\uC81D\uD2B8\uB85C
        \uBCC0\uD569\uB2C8\uB2E4."
      characterPosition: {x: 290, y: 330}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 20, y: 175}
      highlightSize: {x: 680, y: 865}
      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uC790, \uB4DC\uB77C\uC774\uBC84 \uB450 \uAC1C\uB97C \uD569\uC131\uD574
        \uD39C\uCE58\uB97C \uB9CC\uB4E4\uC5B4\uBCFC\uAE4C\uC694?"
      characterPosition: {x: 290, y: 330}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 220, y: 560}
      highlightSize: {x: 190, y: 100}
      fingerPosition: {x: 345, y: 615}
      fingerRotation: -150
      fingerAnimType: 0
      fingerAnimationAmount: 100
      completionCondition: 4
    - dialogue: "\uC544\uC8FC \uC798\uD558\uC168\uC5B4\uC694!"
      characterPosition: {x: 290, y: 330}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
