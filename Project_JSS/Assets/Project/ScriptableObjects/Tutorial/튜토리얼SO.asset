      fingerPosition: {x: 335, y: 1105}
      fingerRotation: -150
      fingerAnimType: 1
      fingerAnimationAmount: 0
      completionCondition: 9
    - dialogue: "\uAC00\uAD6C \uBE44\uCE58\uC5D0 \uD544\uC694\uD55C \uBCC4\uC774
        \uBAA8\uB450 \uBAA8\uC600\uAD70\uC694. \uC81C\uC791 \uBAA9\uB85D\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
      characterPosition: {x: 290, y: -240}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 15, y: 1050}
      highlightSize: {x: 155, y: 145}
      fingerPosition: {x: 200, y: 1105}
      fingerRotation: -150
      fingerAnimType: 1
      fingerAnimationAmount: 0
      completionCondition: 2
    - dialogue: "\uC774\uB3D9\uC744 \uB20C\uB7EC \uAC00\uAD6C\uB97C \uBE44\uCE58\uD558\uB7EC
        \uAC00\uC2DC\uC8E0. \uC774\uC820 \uC800 \uB300\uC2E0, \uBA54\uC774\uB4DC
        \uD3AD\uADC4\uC774 \uC124\uBA85\uC744 \uB3C4\uC640\uC904 \uAC83\uC785\uB2C8\uB2E4."
