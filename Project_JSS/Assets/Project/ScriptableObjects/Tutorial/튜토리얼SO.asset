      fingerRotation: -150
      fingerAnimType: 1
      fingerAnimationAmount: 0
      completionCondition: 8
    - dialogue: "\uC9C0\uAE08\uBD80\uD130\uB294 \uAC1D\uC2E4\uC5D0 \uAC00\uAD6C\uB97C
