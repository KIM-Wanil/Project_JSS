      highlightSize: {x: 680, y: 865}
      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uC790, \uB4DC\uB77C\uC774\uBC84 \uB450 \uAC1C\uB97C \uD569\uC131\uD574
