      fingerPosition: {x: 455, y: 615}
      fingerRotation: -150
      fingerAnimType: 0
      fingerAnimationAmount: 100
      completionCondition: 5
    - dialogue: "\uC0C8\uB85C\uC6B4 \uC544\uC774\uD15C\uC774 \uB098\uC654\uAD70\uC694."
