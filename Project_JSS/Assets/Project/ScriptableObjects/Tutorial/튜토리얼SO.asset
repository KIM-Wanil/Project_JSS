      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uD39C\uCE58\uB97C \uC7A0\uAE34 \uD39C\uCE58\uC640 \uD569\uC131\uD574
        \uD50C\uB77C\uC774\uC5B4\uB97C \uB9CC\uB4E4\uC5B4\uBCF4\uC2DC\uC8E0."
