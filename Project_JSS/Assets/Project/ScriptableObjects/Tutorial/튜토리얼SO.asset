      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uC774\uB3D9\uC744 \uB20C\uB7EC \uAC00\uAD6C\uB97C \uBE44\uCE58\uD558\uB7EC
        \uAC00\uC2DC\uC8E0. \uC774\uC820 \uC800 \uB300\uC2E0<c> \uBA54\uC774\uB4DC
