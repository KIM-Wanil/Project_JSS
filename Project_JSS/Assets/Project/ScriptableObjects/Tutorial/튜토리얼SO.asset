      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uD130\uCE58\uD560 \uB54C\uB9C8\uB2E4 \uC544\uC774\uD15C\uC744 \uACC4\uC18D
