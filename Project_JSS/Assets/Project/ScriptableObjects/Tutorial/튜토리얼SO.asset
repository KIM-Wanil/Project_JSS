      fingerAnimType: 1
      fingerAnimationAmount: 0
      completionCondition: 3
    - dialogue: "\uAC1D\uC2E4 \uC900\uBE44\uC758 \uAE30\uBCF8\uC740 \u2018\uD569\uC131\u2019\uC785\uB2C8\uB2E4."
