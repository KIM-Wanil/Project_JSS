      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: "\uC2A4\uD328\uB108\uD569\uC131"
    - dialogue: "\uC774\uC81C \uACC4\uC18D \uD569\uC131\uD574\uC11C \uB9DD\uCE58\uB97C
        \uB9CC\uB4E4\uC5B4\uBCFC\uAE4C\uC694?"
      characterPosition: {x: 1, y: 1}
