  m_Name: "\uD29C\uD1A0\uB9AC\uC5BCSO"
  m_EditorClassIdentifier: 
  tutorialEvents:
  - eventId: TUTORIAL1
    dialogues:
    - dialogue: "\uC624<c> \uBC14\uB85C \uCCAB \uC190\uB2D8\uC774 \uB3C4\uCC29\uD558\uC168\uAD70\uC694."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uC774\uCABD\uC73C\uB85C \uC548\uB0B4\uD574\uB4DC\uB9B4\uAC8C\uC694."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 1
      fingerAnimationAmount: 10
      completionCondition: "\uBA38\uC9C0\uD654\uBA74\uC774\uB3D9\uD074\uB9AD"
    - dialogue: "\uC190\uB2D8\uAED8\uC11C \uC694\uCCAD\uD558\uC2E0 \uC758\uB8B0\uC11C\uB97C
        \uD568\uAED8 \uBCFC\uAE4C\uC694?"
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 1
      fingerAnimationAmount: 10
      completionCondition: "\uC81C\uC791\uBAA9\uB85D\uD074\uB9AD"
    - dialogue: "\uD544\uC694\uD55C \uBB3C\uAC74\uC744 \uB9CC\uB4E4\uC5B4 \uAC1D\uC2E4\uC744
        \uC900\uBE44\uD558\uB294 \uAC83\uC774 \uC800\uD76C\uC758 \uC77C\uC785\uB2C8\uB2E4."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uBB3C\uAC74\uC744 \uB9CC\uB4DC\uB294 \uBC29\uBC95\uC744 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 1
      fingerAnimationAmount: 10
      completionCondition: "\uB2EB\uAE30\uBC84\uD2BC\uD074\uB9AD"
    - dialogue: "\uAC1D\uC2E4 \uC900\uBE44\uC758 \uAE30\uBCF8\uC740 \u2018\uD569\uC131\u2019\uC785\uB2C8\uB2E4."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uAC19\uC740 \uBB3C\uAC74 \uB450 \uAC1C\uB97C \uB4DC\uB798\uADF8\uD558\uC5EC
        \uD569\uCE58\uBA74<c> \uB354 \uB192\uC740 \uB4F1\uAE09\uC758 \uC624\uBE0C\uC81D\uD2B8\uB85C
        \uBCC0\uD569\uB2C8\uB2E4."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uC790<c> \uB4DC\uB77C\uC774\uBC84 \uB450 \uAC1C\uB97C \uD569\uC131\uD574
        \uC2A4\uD328\uB108\uB97C \uB9CC\uB4E4\uC5B4\uBCFC\uAE4C\uC694?"
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: "\uC2A4\uD328\uB108 \uD569\uC131"
    - dialogue: "\uC544\uC8FC \uC798\uD558\uC168\uC5B4\uC694!"
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uC774\uB807\uAC8C \uB300\uBD80\uBD84\uC758 \uC624\uBE0C\uC81D\uD2B8\uB294
        \uD569\uC131\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uCC38\uACE0\uB85C \uC790\uBB3C\uC1E0\uAC00 \uC788\uB294 \uC624\uBE0C\uC81D\uD2B8\uB294
        \uC774\uB3D9\uC740 \uB418\uC9C0 \uC54A\uC9C0\uB9CC<c> \uD569\uC131\uC740
        \uAC00\uB2A5\uD569\uB2C8\uB2E4."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uC7A0\uC2DC\uB9CC\uC694<c> \uC81C\uB108\uB808\uC774\uD130\uC5D0
        \uB300\uD574 \uC124\uBA85\uC744 \uBE7C\uBA39\uC5C8\uAD70\uC694."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uBC88\uAC1C \uBAA8\uC591\uC774 \uC788\uB294 \uAC83\uC774 \uC81C\uB108\uB808\uC774\uD130\uC785\uB2C8\uB2E4."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uD130\uCE58\uD560 \uB54C\uB9C8\uB2E4 \uC624\uBE0C\uC81D\uD2B8\uB97C
        \uACC4\uC18D \uC0DD\uC131\uD574\uC900\uB2F5\uB2C8\uB2E4."
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
      highlightPosition: {x: 1, y: 1}
      highlightSize: {x: 1, y: 1}
      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 1
      fingerAnimationAmount: 10
      completionCondition: "\uC81C\uB108\uB808\uC774\uD130\uD074\uB9AD"
    - dialogue: "\uC774\uC81C \uACC4\uC18D \uD569\uC131\uD574\uC11C \uB9DD\uCE58\uB97C
        \uB9CC\uB4E4\uC5B4\uBCFC\uAE4C\uC694?"
      characterPosition: {x: 1, y: 1}
      characterName: "\uC9D1\uC0AC \uD3AD\uADC4"
