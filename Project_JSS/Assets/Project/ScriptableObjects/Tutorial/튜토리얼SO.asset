      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 10
    - dialogue: "\uC798\uD558\uC168\uC5B4\uC694! \uC774\uB807\uAC8C \uC190\uB2D8\uC758
