      completionCondition: "\uB9DD\uCE58\uD569\uC131"
    - dialogue: "\uC624<c> \uD544\uC694\uD558\uB358 \uB9DD\uCE58\uB97C \uC644\uC131\uD558\uC168\uAD70\uC694!"
