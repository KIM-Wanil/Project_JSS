      fingerPosition: {x: 1, y: 1}
      fingerRotation: 50
      fingerAnimType: 0
      fingerAnimationAmount: 10
      completionCondition: 
    - dialogue: "\uAC00\uAD6C \uBE44\uCE58\uC5D0 \uD544\uC694\uD55C \uBCC4\uC774
