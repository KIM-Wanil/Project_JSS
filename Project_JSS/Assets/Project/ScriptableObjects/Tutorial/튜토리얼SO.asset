      fingerPosition: {x: 0, y: 0}
      fingerRotation: 0
      fingerAnimType: 0
      fingerAnimationAmount: 0
      completionCondition: 0
    - dialogue: "\uBC88\uAC1C \uBAA8\uC591\uC774 \uC788\uB294 \uC544\uC774\uD15C\uC740
        \uC81C\uB108\uB808\uC774\uD130\uC785\uB2C8\uB2E4."
      characterPosition: {x: 290, y: 330}
