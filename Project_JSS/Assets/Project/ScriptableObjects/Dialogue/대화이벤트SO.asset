%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8efea31799241d840aabc7e059d5a945, type: 3}
  m_Name: "\uB300\uD654\uC774\uBCA4\uD2B8SO"
  m_EditorClassIdentifier: 
  dialogueEvents:
  - eventId: EVENT0
    dialogues:
    - dialogueId: 0
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uC544, \uC624\uC168\uAD70\uC694."
      nextDialogueId: 1
    - dialogueId: 1
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uC5EC\uAE34 \u2018\uC774\uC138\uACC4 \uD3AD\uADC4 \uD638\uD154\u2019\uC785\uB2C8\uB2E4."
      nextDialogueId: 2
    - dialogueId: 2
      speakerName: ME
      dialogueText: "\u2026\uC774\uC138\uACC4? \uD3AD\uADC4? \uD638\uD154\uC694?"
      nextDialogueId: 3
    - dialogueId: 3
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uB124, \uB2E4\uC18C \uC0DD\uC18C\uD560 \uC218\uB3C4 \uC788\uC8E0."
      nextDialogueId: 4
    - dialogueId: 4
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uC774\uACF3\uC740 \uC5EC\uB7EC \uC138\uACC4\uC758 \uD3AD\uADC4\uB4E4\uC774
        \uBA38\uBB34\uB294 \uC27C\uD130\uB78D\uB2C8\uB2E4."
      nextDialogueId: 5
    - dialogueId: 5
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uBD81\uADF9\uC5D0\uC11C, \uBC14\uB2F7\uC18D\uC5D0\uC11C\u2026
        \uB2E4\uC591\uD55C \uC190\uB2D8\uB4E4\uC774 \uC624\uC138\uC694."
      nextDialogueId: 6
    - dialogueId: 6
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uC5B8\uC81C \uB204\uAC00 \uC62C\uC9C4 \uC544\uBB34\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
      nextDialogueId: 7
    - dialogueId: 7
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uADF8\uB798\uC11C \uB298 \uC900\uBE44\uB418\uC5B4 \uC788\uC5B4\uC57C
        \uD558\uC8E0."
      nextDialogueId: 8
    - dialogueId: 8
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uC774 \uD638\uD154\uC758 \uC9C0\uBC30\uC778\uB2D8\uC73C\uB85C,
        \uB2F9\uC2E0\uC744 \uBAA8\uC2DC\uACE0\uC790 \uD569\uB2C8\uB2E4."
      nextDialogueId: 9
    - dialogueId: 9
      speakerName: ME
      dialogueText: "\uC81C\uAC00 \uADF8\uAC78\u2026 \uC798 \uD560 \uC218 \uC788\uC744\uAE4C\uC694?"
      nextDialogueId: 10
    - dialogueId: 10
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uBB3C\uB860\uC774\uC8E0. \uC81C\uAC00 \uB3C4\uC640\uB4DC\uB9B4
        \uD14C\uB2C8\uAE4C\uC694."
      nextDialogueId: 11
    - dialogueId: 11
      speakerName: "\uC9D1\uC0AC \uD3AD\uADC4"
      dialogueText: "\uC790, \uCCAB \uC190\uB2D8\uC744 \uB9DE\uC774\uD574\uBCFC\uAE4C\uC694?"
      nextDialogueId: -1
  - eventId: EVENT1
    dialogues:
    - dialogueId: 0
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uC544\u2026 \uC548\uB155\uD558\uC138\uC694!"
      nextDialogueId: 1
    - dialogueId: 1
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uC81C\uAC00\u2026 \uCCAB \uC190\uB2D8\uC778\uAC00\uC694?"
      nextDialogueId: 2
    - dialogueId: 2
      speakerName: ME
      dialogueText: "\uB124! \uB9DE\uC544\uC694. \uC5B4\uC11C \uC624\uC138\uC694."
      nextDialogueId: 3
    - dialogueId: 3
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uC73C\uC74C\u2026 \uC870\uAE08 \uAE34\uC7A5\uB418\uB124\uC694."
      nextDialogueId: 4
    - dialogueId: 4
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uD3B8\uD788 \uC274 \uACF5\uAC04\uC774 \uC788\uC5C8\uC73C\uBA74
        \uC88B\uACA0\uC5B4\uC694."
      nextDialogueId: 5
    - dialogueId: 5
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uD639\uC2DC\u2026 \uC81C \uBC29\uC744 \uD558\uB098 \uAFB8\uBA70\uC8FC\uC2E4
        \uC218 \uC788\uC744\uAE4C\uC694?"
      nextDialogueId: 6
    - dialogueId: 6
      speakerName: ME
      dialogueText: "\uBB3C\uB860\uC774\uC8E0! \uC5B4\uB5A4 \uBD84\uC704\uAE30\uB85C
        \uD574\uB4DC\uB9B4\uAE4C\uC694?"
      nextDialogueId: 7
    - dialogueId: 7
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uC74C\u2026 \uB108\uBB34 \uD654\uB824\uD558\uC9C4 \uC54A\uC558\uC73C\uBA74
        \uC88B\uACA0\uC5B4\uC694."
      nextDialogueId: 8
    - dialogueId: 8
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uCE68\uB300\uB791 \uC791\uC740 \uCC45\uC0C1 \uC815\uB3C4\uB9CC
        \uC788\uC73C\uBA74 \uCDA9\uBD84\uD574\uC694."
      nextDialogueId: 9
    - dialogueId: 9
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uCC45\uC744 \uC77D\uAC70\uB098\u2026 \uB0AE\uC7A0\uC744 \uC798
        \uC218 \uC788\uB294 \uC815\uB3C4\uBA74 \uC88B\uACA0\uC5B4\uC694."
      nextDialogueId: 10
    - dialogueId: 10
      speakerName: ME
      dialogueText: "\uB9E1\uACA8\uB9CC \uC8FC\uC138\uC694. \uBC14\uB85C \uC900\uBE44\uD574\uB4DC\uB9B4\uAC8C\uC694."
      nextDialogueId: 11
    - dialogueId: 11
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uAE30\uB300\uD558\uACE0 \uC788\uC744\uAC8C\uC694."
      nextDialogueId: -1
  - eventId: EVENT2
    dialogues:
    - dialogueId: 0
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uC640...! \uBC29\uC774 \uC815\uB9D0 \uC608\uC058\uB124\uC694."
      nextDialogueId: 1
    - dialogueId: 1
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uCD08\uB85D\uC0C9\uC774 \uB9CE\uC544\uC11C \uADF8\uB7F0\uC9C0
        \uB9C8\uC74C\uC774 \uD3B8\uD574\uC838\uC694."
      nextDialogueId: 2
    - dialogueId: 2
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uCE68\uB300\uB3C4 \uD3EC\uADFC\uD574 \uBCF4\uC5EC\uC11C \uBC14\uB85C
        \uB215\uACE0 \uC2F6\uC5B4\uC694."
      nextDialogueId: 3
    - dialogueId: 3
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uC774\uB7F0 \uB530\uB73B\uD55C \uBC29\uC744 \uC900\uBE44\uD574\uC8FC\uC154\uC11C
        \uC815\uB9D0 \uAC10\uC0AC\uD569\uB2C8\uB2E4."
      nextDialogueId: 4
    - dialogueId: 4
      speakerName: ME
      dialogueText: "(\uD3AD\uADC4\uC774 \uB530\uB73B\uD55C \uAC78 \uC88B\uC544\uD558\uB098?)"
      nextDialogueId: 5
    - dialogueId: 5
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uC5EC\uAE30\uC11C\uB77C\uBA74 \uD479 \uC26C\uACE0 \uB2E4\uC2DC
        \uD798\uB0BC \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694."
      nextDialogueId: 6
    - dialogueId: 6
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uC7A0\uC2DC \uBA38\uBB34\uB294 \uB3D9\uC548 \uC798 \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694."
      nextDialogueId: 7
    - dialogueId: 7
      speakerName: "\uD3AD\uADC4"
      dialogueText: "\uB2E4\uC74C\uC5D0 \uB610 \uC778\uC0AC\uB4DC\uB9B4\uAC8C\uC694!"
      nextDialogueId: 8
    - dialogueId: 8
      speakerName: ME
      dialogueText: "\uC5B8\uC81C\uB4E0 \uD658\uC601\uC774\uC5D0\uC694. \uD3B8\uD788
        \uC26C\uC138\uC694."
      nextDialogueId: -1
  - eventId: EVENT3
    dialogues:
    - dialogueId: 0
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\u2026\u2026\uB4DC\uB514\uC5B4,"
      nextDialogueId: 1
    - dialogueId: 1
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uC774 \uBAB8\uC758 \uBC1C\uAC78\uC74C\uC744 \uB9C9\uC744 \uC790\uB294
        \uC5C6\uAD70."
      nextDialogueId: 2
    - dialogueId: 2
      speakerName: ME
      dialogueText: ...!!!
      nextDialogueId: 3
    - dialogueId: 3
      speakerName: ME
      dialogueText: "\uC5B4\uC11C \uC624\uC138\uC694!"
      nextDialogueId: 4
    - dialogueId: 4
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uD6C4\uD6D7\u2026 \uB098\uB97C \uBAB0\uB77C\uBCF4\uB294\uAD70."
      nextDialogueId: 5
    - dialogueId: 5
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uC774 \uBAB8\uC740\u2026 \uC554\uD751\uC758 \uC5BC\uC74C \uC704\uC5D0
        \uAD70\uB9BC\uD558\uB294 \uC790."
      nextDialogueId: 6
    - dialogueId: 6
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uB9C8\uC655 \uD3AD\uADC4\uC774\uB2E4."
      nextDialogueId: 7
    - dialogueId: 7
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uC218\uB9CE\uC740 \uCC28\uC6D0\uC744 \uB118\uB098\uB4E4\uB2E4\u2026
        \uC774\uACF3\uC5D0 \uB3C4\uB2EC\uD588\uC9C0."
      nextDialogueId: 8
    - dialogueId: 8
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uC774\uC81C \uC7A0\uC2DC \uC548\uC2DD\uC774 \uD544\uC694\uD558\uB2E4."
      nextDialogueId: 9
    - dialogueId: 9
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uADF8\uB9AC\uACE0\u2026 \uD751\uB9C8\uBC95\uC744 \uC218\uB828\uD560
        \uACF5\uAC04\uB3C4 \uB9D0\uC774\uC9C0."
      nextDialogueId: 10
    - dialogueId: 10
      speakerName: ME
      dialogueText: "\uB124! \uAE08\uBC29 \uC900\uBE44\uD574\uB4DC\uB9B4\uAC8C\uC694!"
      nextDialogueId: 11
    - dialogueId: 11
      speakerName: ME
      dialogueText: "(\uC774\uB7F0 \uC190\uB2D8\uB3C4 \uC624\uB294\uAD6C\uB098\u2026)"
      nextDialogueId: -1
  - eventId: EVENT4
    dialogues:
    - dialogueId: 0
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uD6C4\uD6D7\u2026 \uC774 \uAE30\uC6B4, \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uAD70."
      nextDialogueId: 1
    - dialogueId: 1
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uC774 \uC815\uB3C4\uBA74\u2026 \uC774 \uBAB8\uC758 \uAC70\uCC98\uB85C
        \uC190\uC0C9\uC5C6\uACA0\uC9C0."
      nextDialogueId: 2
    - dialogueId: 2
      speakerName: "\uB9C8\uC655 \uD3AD\uADC4"
      dialogueText: "\uC88B\uC544. \uC774\uACF3\uC744 \u2018\uB9C8\uC655\uC758 \uC548\uC2DD\uCC98\u2019\uB85C
        \uC0BC\uACA0\uB2E4."
      nextDialogueId: -1
  npcSprites:
  - spriteName: "\uB9C8\uC655 \uD3AD\uADC4"
    sprite: {fileID: 21300000, guid: e37667dd09191e04587708c19bc7dad5, type: 3}
  - spriteName: "\uBA54\uC774\uB4DC \uD3AD\uADC4"
    sprite: {fileID: 21300000, guid: 1ee4db25c5c17014a8aff4f520e87fb3, type: 3}
  - spriteName: "\uC5F0\uAE08\uC220\uC0AC \uD3AD\uADC4"
    sprite: {fileID: 21300000, guid: d422d2f2b2ee608499544009022bc09a, type: 3}
  - spriteName: "\uC6A9\uC0AC \uD3AD\uADC4"
    sprite: {fileID: 21300000, guid: 41f91799f16ec674ea6762fab92e5477, type: 3}
  - spriteName: "\uC9D1\uC0AC \uD3AD\uADC4"
    sprite: {fileID: 21300000, guid: 534bc58fc7ae92445922484fb2de6945, type: 3}
